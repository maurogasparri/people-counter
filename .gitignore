# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Project-specific secrets (NEVER commit)
/config/config.yaml
/certs/
*.pem
*.pem.crt
*.pem.key
.env
*.shadow.json

# Binary artifacts
*.npz
*.hef
*.onnx
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
# Windows reserved device name — Git Bash on Windows sometimes materializes
# `nul` in the cwd from `2>nul` redirects (PowerShell doesn't see it as a
# file but git does). Always ignore.
/nul

# Models (downloaded, not committed)
/models/

# Calibration captures (large image sets)
/calibration_captures/
/calibration/captures/

# Diagnostic output artifacts (downloaded from device for inspection)
/diagnose_*.jpg
/diagnose_*.png
/verify_*.jpg
/verify_*.png
/focus_*.jpg
/focus_*.png

# Ad-hoc debug / session artifacts — anything dropped here is ignored.
# Use this for downloaded reports, screenshots, pasted outputs, etc.
/debug/

# Training datasets — Roboflow overhead_person, WEPDTOF, etc. Big binary
# blobs that don't belong in git. Path referenced by scripts/training/*.
# Use /dataset/* (not /dataset/) so the README exception below works —
# gitignore can't re-include a file when its parent directory is ignored.
/dataset/*
!/dataset/README.md

.claude/
