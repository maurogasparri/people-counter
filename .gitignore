# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Project-specific secrets (NEVER commit)
/config/config.yaml
/certs/
*.pem
*.pem.crt
*.pem.key
.env
*.shadow.json

# Binary artifacts
*.npz
*.hef
*.onnx
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
# Windows reserved device name — Git Bash on Windows sometimes materializes
# `nul` in the cwd from `2>nul` redirects (PowerShell doesn't see it as a
# file but git does). Always ignore.
/nul

# Models (downloaded, not committed)
/models/
# Pesos COCO off-the-shelf que baja ultralytics (ej. al correr
# scripts/training/compare_detectors.py). Build artifact, regenerable.
/yolov8n.pt

# Ultralytics default training/eval output dir — generated when calling
# YOLO().train()/val() without an explicit project=. Regenerable, no value.
/runs/

# Kaggle download outputs — comparison.json y artefactos sueltos del
# notebook de training. Los .pt / .onnx útiles se mueven a /models/.
/kaggle_outputs/

# Calibration captures (large image sets)
/calibration_captures/
/calibration/captures/

# Diagnostic output artifacts (downloaded from device for inspection)
/diagnose_*.jpg
/diagnose_*.png
/verify_*.jpg
/verify_*.png
/focus_*.jpg
/focus_*.png

# Ad-hoc debug / session artifacts — anything dropped here is ignored.
# Use this for downloaded reports, screenshots, pasted outputs, etc.
/debug/

# Provisioning outputs per device (certs X.509 + per-thing config). Sensible.
/provisioned/

# Ad-hoc Lambda / IoT / CFN test artifacts en la raiz del repo (smoke tests,
# describe-stacks dumps, etc.). Si necesitas algo permanente, va a /debug/.
/test-event.json
/test-output.json
/cs-details.json

# Training workspace — sites.yaml con IPs + matrices, captures rectificadas,
# manifests, clips. Pesado y/o sensible. Trackear sólo el README y el
# template del YAML.
/training_data/*
!/training_data/README.md
!/training_data/sites.yaml.example

.claude/
