# Variables de entorno para training (Phase A).
#
# Copiá este archivo a scripts/training/.env (gitignoreado), llenalo con
# valores reales, y después cargalas antes de correr los scripts:
#
#   bash:
#     set -a && source scripts/training/.env && set +a
#
#   PowerShell:
#     Get-Content scripts/training/.env | ForEach-Object {
#       if ($_ -match '^([^=]+)=(.*)$') {
#         Set-Item "env:$($matches[1])" $matches[2]
#       }
#     }
#
# En Colab la API key vive en Secrets (sidebar 🔑), NO en este archivo.

# API key de Roboflow — sacá una (free) en https://app.roboflow.com
ROBOFLOW_API_KEY=

# Opcional: pin de un dataset específico para que las re-corridas sean
# deterministas. Matchean el shape de la URL
# https://universe.roboflow.com/<workspace>/<project>/<version>.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
