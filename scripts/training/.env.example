# Phase A training environment variables.
#
# Copy this file to scripts/training/.env (gitignored), fill in real
# values, then `set -a && source scripts/training/.env && set +a`
# (bash) or `Get-Content scripts/training/.env | ForEach-Object {
# if ($_ -match '^([^=]+)=(.*)$') { Set-Item "env:$($matches[1])"
# $matches[2] } }` (PowerShell) before running the scripts.
#
# In Colab the API key lives in Secrets (🔑 sidebar), NOT in this file.

# Roboflow API key — get one (free) at https://app.roboflow.com
ROBOFLOW_API_KEY=

# Optional: pin a specific dataset so re-runs are deterministic.
# These match the URL shape https://universe.roboflow.com/<workspace>/<project>/<version>.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
