                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "rawSql": "SELECT DISTINCT ON (device_id) device_id AS metric, cpu_temp_c AS value FROM telemetry t JOIN sites s USING (store_id) WHERE s.status='operational' ORDER BY device_id, event_ts DESC",
