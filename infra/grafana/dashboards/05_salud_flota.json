        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT * FROM (SELECT DISTINCT ON (t.device_id) s.store_name AS \"Sucursal\", t.device_id AS \"Dispositivo\", round(t.fps::numeric,1) AS \"FPS\", t.cpu_temp_c AS \"CPU °C\", t.hailo_temp_c AS \"Hailo °C\", t.disk_free_mb AS \"Disco MB\", t.mem_available_mb AS \"RAM MB\", t.buffer_backlog_messages AS \"Backlog\", t.mqtt_connected AS \"MQTT\", t.wifi_probe_ok AS \"WiFi\", t.ble_scanner_ok AS \"BLE\", t.event_ts AS \"Última muestra\" FROM telemetry t JOIN sites s USING (store_id) WHERE t.store_id IN (${sites:sqlstring}) ORDER BY t.device_id, t.event_ts DESC) q ORDER BY q.\"Sucursal\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
