    {
      "id": 2,
      "type": "table",
      "title": "Frescura de datos por sucursal",
      "description": "Tiempo desde la última ingesta de datos por sucursal. Detecta sucursales que dejaron de reportar.",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT s.store_name AS \"Sucursal\", round(EXTRACT(epoch FROM (now() - f.last_received_at))/60) AS \"Min sin datos\" FROM data_freshness_by_store f JOIN sites s USING (store_id) WHERE f.store_id IN (${sites:sqlstring}) ORDER BY s.store_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "align": "right"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sucursal"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Min sin datos"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background-solid"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "red",
                      "value": 120
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Errores recientes",
      "description": "Últimos errores reportados por los dispositivos (auto-recuperables en su mayoría).",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT t.event_ts AS \"Hora\", s.store_name AS \"Sucursal\", t.device_id AS \"Dispositivo\", COALESCE(t.error, t.schedule_error_detail) AS \"Detalle\" FROM telemetry t JOIN sites s USING (store_id) WHERE t.store_id IN (${sites:sqlstring}) AND (t.error IS NOT NULL OR t.schedule_error_detail IS NOT NULL) ORDER BY t.event_ts DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hora"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
