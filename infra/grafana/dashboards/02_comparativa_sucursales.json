    {
      "id": 13,
      "type": "table",
      "title": "Comparativo vs promedio del grupo",
      "description": "Variación porcentual de cada KPI respecto al promedio de las sucursales seleccionadas en el período. Verde = sobre el promedio, rojo = bajo el promedio.",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH per AS (SELECT c.store_id, SUM(p.sales)::float/NULLIF(SUM(c.ins),0) AS conv, SUM(p.items_sale)::float/NULLIF(SUM(p.sales),0) AS upt, ((COALESCE(SUM(p.amount_minor_sale),0)-COALESCE(SUM(p.amount_minor_return),0))/100.0)/NULLIF(SUM(p.sales),0) AS ticket FROM counting_by_bucket_day c JOIN sites s USING (store_id) LEFT JOIN pos_by_bucket_day p ON c.store_id=p.store_id AND c.bucket_day=p.bucket_day WHERE c.bucket_day BETWEEN $__timeFrom()::date AND $__timeTo()::date AND c.store_id IN (${sites:sqlstring}) GROUP BY c.store_id), avg AS (SELECT AVG(conv) conv, AVG(upt) upt, AVG(ticket) ticket FROM per) SELECT s.store_name AS \"Sucursal\", (per.conv - a.conv)/NULLIF(a.conv,0) AS \"Conversión Δ%\", (per.upt - a.upt)/NULLIF(a.upt,0) AS \"UPT Δ%\", (per.ticket - a.ticket)/NULLIF(a.ticket,0) AS \"Ticket Δ%\" FROM per JOIN sites s USING (store_id) CROSS JOIN avg a ORDER BY s.store_name"
        }
      ],
