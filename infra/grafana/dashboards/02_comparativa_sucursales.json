  "panels": [
    {
      "type": "table",
      "title": "Ranking de sucursales",
      "description": "Indicadores clave por sucursal en el período. Click en una fila para abrir el detalle de esa sucursal. Ordenable por cualquier columna.",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH agg AS (SELECT c.store_id, s.store_name, s.sales_area_m2, SUM(c.ins) ins, SUM(p.sales) sales, (COALESCE(SUM(p.amount_minor_sale),0)-COALESCE(SUM(p.amount_minor_return),0))/100.0 fact, SUM(p.items_sale) it_s, SUM(p.items_return) it_r FROM counting_by_bucket_day c JOIN sites s USING (store_id) LEFT JOIN pos_by_bucket_day p ON c.store_id=p.store_id AND c.bucket_day=p.bucket_day WHERE c.store_id IN (${sites:sqlstring}) AND c.bucket_day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY c.store_id, s.store_name, s.sales_area_m2) SELECT store_id, store_name AS \"Sucursal\", sales::float/NULLIF(ins,0) AS \"Conversión\", it_s::float/NULLIF(sales,0) AS \"UPT\", fact/NULLIF(sales,0) AS \"Ticket promedio\", fact/NULLIF(sales_area_m2,0) AS \"Facturación/m²\", sales AS \"Transacciones\", it_s AS \"Unidades\", fact AS \"Facturación\", it_r::float/NULLIF(it_s,0) AS \"Tasa de devolución\" FROM agg ORDER BY store_name"
        }
      ],
