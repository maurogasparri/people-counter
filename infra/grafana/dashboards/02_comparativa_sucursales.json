      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH cur AS (SELECT c.store_id, s.sales_area_m2 area, SUM(c.ins) ins, SUM(p.sales) sales, SUM(p.items_sale) it_s, SUM(p.items_return) it_r, (COALESCE(SUM(p.amount_minor_sale),0)-COALESCE(SUM(p.amount_minor_return),0))/100.0 fact FROM counting_by_bucket_day c JOIN sites s USING (store_id) LEFT JOIN pos_by_bucket_day p ON c.store_id=p.store_id AND c.bucket_day=p.bucket_day WHERE c.bucket_day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY c.store_id, s.sales_area_m2), prev AS (SELECT c.store_id, s.sales_area_m2 area, SUM(c.ins) ins, SUM(p.sales) sales, SUM(p.items_sale) it_s, SUM(p.items_return) it_r, (COALESCE(SUM(p.amount_minor_sale),0)-COALESCE(SUM(p.amount_minor_return),0))/100.0 fact FROM counting_by_bucket_day c JOIN sites s USING (store_id) LEFT JOIN pos_by_bucket_day p ON c.store_id=p.store_id AND c.bucket_day=p.bucket_day WHERE c.bucket_day BETWEEN ($__timeFrom()::date - (($__timeTo()::date - $__timeFrom()::date)+1)) AND ($__timeFrom()::date - 1) GROUP BY c.store_id, s.sales_area_m2) SELECT s.store_name AS \"Sucursal\", ((cur.sales::float/NULLIF(cur.ins,0)) - (prev.sales::float/NULLIF(prev.ins,0))) / NULLIF((prev.sales::float/NULLIF(prev.ins,0)),0) AS \"Conversión Δ%\", ((cur.it_s::float/NULLIF(cur.sales,0)) - (prev.it_s::float/NULLIF(prev.sales,0))) / NULLIF((prev.it_s::float/NULLIF(prev.sales,0)),0) AS \"UPT Δ%\", ((cur.fact/NULLIF(cur.sales,0)) - (prev.fact/NULLIF(prev.sales,0))) / NULLIF((prev.fact/NULLIF(prev.sales,0)),0) AS \"Ticket Δ%\" FROM cur JOIN sites s USING (store_id) LEFT JOIN prev USING (store_id) WHERE cur.store_id IN (${sites:sqlstring}) ORDER BY s.store_name"
        }
      ],
