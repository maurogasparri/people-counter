    {
      "id": 12,
      "type": "xychart",
      "title": "Posicionamiento de sucursales (conversión × ticket promedio)",
      "description": "Cada sucursal posicionada por tasa de conversión (eje X) y ticket promedio (eje Y). Cuadrante superior-derecho = mejor. Cada color = una sucursal (leyenda).",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH agg AS (SELECT s.store_name, SUM(p.sales)::float/NULLIF(SUM(c.ins),0) AS conv, (COALESCE(SUM(p.amount_minor_sale),0)-COALESCE(SUM(p.amount_minor_return),0))/100.0/NULLIF(SUM(p.sales),0) AS ticket FROM counting_by_bucket_day c JOIN sites s USING (store_id) LEFT JOIN pos_by_bucket_day p ON c.store_id=p.store_id AND c.bucket_day=p.bucket_day WHERE c.store_id IN (${sites:sqlstring}) AND c.bucket_day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY s.store_name HAVING SUM(c.ins)>0) SELECT conv AS \"Conversión\", CASE WHEN store_name='Abasto' THEN ticket END AS \"Abasto\", CASE WHEN store_name='Alto Avellaneda' THEN ticket END AS \"Alto Avellaneda\", CASE WHEN store_name='Alto Comahue' THEN ticket END AS \"Alto Comahue\", CASE WHEN store_name='Alto Palermo' THEN ticket END AS \"Alto Palermo\", CASE WHEN store_name='Córdoba Shopping' THEN ticket END AS \"Córdoba Shopping\", CASE WHEN store_name='Los Gallegos' THEN ticket END AS \"Los Gallegos\", CASE WHEN store_name='Mendoza Plaza' THEN ticket END AS \"Mendoza Plaza\", CASE WHEN store_name='Unicenter' THEN ticket END AS \"Unicenter\" FROM agg ORDER BY store_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "pointSize": {
              "fixed": 9
            },
            "axisLabel": "Ticket promedio"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Conversión"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.axisLabel",
                "value": "Tasa de conversión"
              }
            ]
          }
        ]
      },
      "options": {
        "seriesMapping": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
