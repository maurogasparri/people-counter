    {
      "id": 11,
      "type": "table",
      "title": "Comparativo vs período anterior",
      "description": "Variación porcentual de cada KPI respecto al período inmediato anterior de igual duración. Verde = mejora, rojo = empeora.",
      "datasource": {
        "type": "postgres",
        "uid": "__DS_UID__"
