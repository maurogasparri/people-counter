          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT sample_time AS time, cpu_temp_c, hailo_temp_c FROM telemetry WHERE $__timeFilter(sample_time) ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
