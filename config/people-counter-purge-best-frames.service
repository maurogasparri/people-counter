[Unit]
Description=People Counter — purga de JPGs best-frame pasados de retención
# Corre incluso cuando el people-counter.service principal está detenido: la
# retención es una garantía legal que debe sostenerse sin importar el estado
# del pipeline.

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
Environment="PYTHONPATH=/usr/src/people-counter"
# Los días de retención mirrorean best_frame.retention_days del config
# mergeado (default 7, seteado en config/config.example.yaml). El pipeline
# lee el YAML; este unit hardcodea el mismo número así las purgas se
# mantienen enforced aún cuando el servicio principal está detenido.
# Mantener ambos en sync si cambia.
ExecStart=/usr/bin/python3 /usr/src/people-counter/scripts/purge_best_frames.py \
    --output-dir /var/lib/people-counter/best_frames \
    --retention-days 7

# Hardening: este unit solo necesita read+unlink bajo el dir de JPGs.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/people-counter/best_frames
PrivateTmp=true

# Loguear al journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter-purge-best-frames
