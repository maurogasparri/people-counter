[Unit]
Description=People Counter — purge best-frame JPGs past retention
# Runs even when the main people-counter.service is stopped: retention is
# a legal guarantee that must hold regardless of pipeline state.

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
Environment="PYTHONPATH=/usr/src/people-counter"
# Retention days are sourced from hardware.yaml's best_frame.retention_days.
# Default 7 — change here AND in hardware.yaml if you adjust it.
ExecStart=/usr/bin/python3 /usr/src/people-counter/scripts/purge_best_frames.py \
    --output-dir /var/lib/people-counter/best_frames \
    --retention-days 7

# Hardening: this unit only needs to read+unlink under the JPG dir.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/people-counter/best_frames
PrivateTmp=true

# Log to journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter-purge-best-frames
