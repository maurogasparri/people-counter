[Unit]
Description=People Counter — purga diaria de JPGs best-frame

[Timer]
# Diario a las 03:30, bien antes del reset de las 04:00 y antes de que abran
# los locales. Persistent=true atrapa un run perdido si el dispositivo estuvo
# apagado a las 03:30.
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
