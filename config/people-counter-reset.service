[Unit]
Description=Reset diario del People Counter (dedup counters + totales de conteo)

[Service]
Type=oneshot
# Corre como root así systemctl restart (del servicio principal) funciona sin
# wiring de polkit/sudoers. DedupEngine.reset_daily solo hace DELETEs sobre un
# archivo sqlite existente — sin cambio de ownership en
# /var/lib/people-counter/dedup.db.
WorkingDirectory=/usr/src/people-counter
Environment="PYTHONPATH=/usr/src/people-counter"
# Prefijo '-': la falla del reset de dedup no bloquea el restart del servicio
# de abajo, que también resetea los counters en memoria (LineCounter.total_in/
# total_out).
ExecStart=-/usr/bin/python3 -c "from src.wifi_ble.dedup import DedupEngine; d = DedupEngine('/var/lib/people-counter/dedup.db'); d.reset_daily(); print('Dedup reset done')"
ExecStart=/bin/systemctl restart people-counter.service
