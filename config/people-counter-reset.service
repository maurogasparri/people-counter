[Unit]
Description=People Counter daily reset (dedup counters + counting totals)

[Service]
Type=oneshot
# Runs as root so that systemctl restart (for the main service) works without
# polkit/sudoers wiring. The DedupEngine.reset_daily only issues DELETEs on an
# existing sqlite file — no ownership change on /var/lib/people-counter/dedup.db.
WorkingDirectory=/usr/src/people-counter
Environment="PYTHONPATH=/usr/src/people-counter"
# '-' prefix: dedup reset failure does not block the service restart below,
# which also resets in-memory counters (LineCounter.total_in/total_out).
ExecStart=-/usr/bin/python3 -c "from src.wifi_ble.dedup import DedupEngine; d = DedupEngine('/var/lib/people-counter/dedup.db'); d.reset_daily(); print('Dedup reset done')"
ExecStart=/bin/systemctl restart people-counter.service
