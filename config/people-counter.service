[Unit]
Description=People Counter Edge Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
ExecStart=/usr/bin/python3 -m src.main --config /etc/people-counter/config.yaml
Restart=always
RestartSec=10
WatchdogSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# /usr/src/people-counter incluido porque HailoRT escribe pyhailort.log y
# hailort.log en CWD (que es WorkingDirectory). Sin este path la activación
# del HEF falla con OSError errno=30 read-only filesystem.
ReadWritePaths=/var/lib/people-counter /var/log/people-counter /etc/people-counter /usr/src/people-counter
PrivateTmp=true

# Resource accounting — habilita las métricas que expone systemd vía
# `systemctl show people-counter --property=MemoryCurrent,MemoryPeak,CPUUsageNSec`
# y `systemd-cgtop`. Costo ~0 (solo lectura de cgroup counters que ya existen).
# Sin esto, MemoryCurrent y MemoryPeak son [not set] y no podemos auditar
# crecimiento de RSS / leaks en producción sin shellar a la Pi con ps.
MemoryAccounting=yes
CPUAccounting=yes

# Capabilities que necesita el servicio corriendo como user no-root (pi):
#  - CAP_NET_BIND_SERVICE: el web viewer bindea al puerto 80 (--web-viewer-port).
#  - CAP_NET_ADMIN: WiFi probing — el pipeline pone wlan0 en monitor mode via
#    `ip link set wlan0 down/up` + `iw dev wlan0 set type monitor`. Sin esto
#    falla con "Operation not permitted" y el probing queda desactivado (no-fatal).
#  - CAP_NET_RAW: scapy sniffea los probe requests 802.11 con raw sockets.
# Pasar --web-viewer-port 0 deshabilita el viewer (no usa NET_BIND_SERVICE).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
