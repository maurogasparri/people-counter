[Unit]
Description=People Counter Edge Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
ExecStart=/usr/bin/python3 -m src.main --config /etc/people-counter/config.yaml
Restart=always
RestartSec=10
WatchdogSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/people-counter /var/log/people-counter /etc/people-counter
PrivateTmp=true

# Live web viewer binds to port 80 by default (--web-viewer-port). Granting
# CAP_NET_BIND_SERVICE to the service user (pi) lets it bind privileged
# ports without running as root. Pass --web-viewer-port 0 in ExecStart to
# disable the viewer; in that case this capability is unused.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
