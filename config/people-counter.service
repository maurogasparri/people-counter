[Unit]
Description=People Counter Edge Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
ExecStart=/usr/bin/python3 -m src.main --config /etc/people-counter/config.yaml
Restart=always
RestartSec=10
WatchdogSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# /usr/src/people-counter incluido porque HailoRT escribe pyhailort.log y
# hailort.log en CWD (que es WorkingDirectory). Sin este path la activación
# del HEF falla con OSError errno=30 read-only filesystem.
ReadWritePaths=/var/lib/people-counter /var/log/people-counter /etc/people-counter /usr/src/people-counter
PrivateTmp=true

# El web viewer en vivo bindea al puerto 80 por default (--web-viewer-port).
# Otorgarle CAP_NET_BIND_SERVICE al user del servicio (pi) le permite bindear
# puertos privilegiados sin correr como root. Pasar --web-viewer-port 0 en
# ExecStart para deshabilitar el viewer; en ese caso esta capability no se usa.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
