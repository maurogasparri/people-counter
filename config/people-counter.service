[Unit]
Description=People Counter Edge Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi
WorkingDirectory=/usr/src/people-counter
ExecStart=/usr/bin/python3 -m src.main --config /etc/people-counter/config.yaml
Restart=always
RestartSec=10
WatchdogSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=people-counter

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# /usr/src/people-counter incluido porque HailoRT escribe pyhailort.log y
# hailort.log en CWD (que es WorkingDirectory). Sin este path la activación
# del HEF falla con OSError errno=30 read-only filesystem.
ReadWritePaths=/var/lib/people-counter /var/log/people-counter /etc/people-counter /usr/src/people-counter
PrivateTmp=true

# --- Sandboxing extra (systemd-analyze security) ---
# Capa adicional de aislamiento. Ninguna toca el hot-path: el servicio lee la
# hora pero no la setea, no carga módulos en runtime (nexmon se carga en el
# setup, no acá), no escribe /proc/sys ni cgroups, y corre como `pi` sin tocar
# /home. NO se agregan SystemCallFilter ni MemoryDenyWriteExecute a propósito:
# romperían Hailo/numpy/scapy (JIT + W^X + syscalls de raw socket).
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
# CRÍTICO: tiene que listar TODAS las familias que usan el proceso y sus
# subprocesos. AF_UNIX = sd_notify + D-Bus de BlueZ (BLE); AF_INET/INET6 = MQTT
# a AWS IoT + web viewer; AF_NETLINK = iw/ip (config de la interface WiFi);
# AF_PACKET = scapy sniffeando los probe requests 802.11. Si falta una, el
# probing WiFi/BLE se rompe en silencio → es el primer sospechoso si algo falla.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

# SMOKE-TEST EN LA PI tras aplicar (no asumir que anda sin verificar):
#   1. systemctl daemon-reload && systemctl restart people-counter
#   2. systemctl status people-counter         → active (running), sin restart loop
#   3. systemd-analyze security people-counter  → exposure bajó (era ~6-7, debería dar ~3-4)
#   4. journalctl -u people-counter -f          → READY=1, FPS normal, sin EPERM/EACCES
#   5. Confirmar WiFi probing (wifi_probe_ok) + BLE (ble_scanner_ok) + MQTT connected
#      en la telemetría — son lo que rompería RestrictAddressFamilies si faltara una familia.
#   Si algo falla: comentar RestrictAddressFamilies primero (el más probable).

# Resource accounting — habilita las métricas que expone systemd vía
# `systemctl show people-counter --property=MemoryCurrent,MemoryPeak,CPUUsageNSec`
# y `systemd-cgtop`. Costo ~0 (solo lectura de cgroup counters que ya existen).
# Sin esto, MemoryCurrent y MemoryPeak son [not set] y no podemos auditar
# crecimiento de RSS / leaks en producción sin shellar a la Pi con ps.
MemoryAccounting=yes
CPUAccounting=yes

# Circuit breakers de memoria — sized para Pi 5 2GB (working set sostenido
# observado en piloto = ~300MB peak). MemoryHigh actúa como soft cap: cuando
# se cruza, el kernel reclama paginas del cgroup primero (presión sobre el
# service, no sobre el resto del sistema). MemoryMax es hard cap: si lo cruza,
# OOM killer mata al service y systemd lo reinicia (Restart=always). Sin estos
# caps un memory leak hipotético podría comerse toda la RAM y arrastrar al
# kernel + dbus + nm. Headroom amplio (5x sobre peak observado) para no
# falsear triggers en bursts WiFi/BLE o preview concurrente.
MemoryHigh=1G
MemoryMax=1500M

# Capabilities que necesita el servicio corriendo como user no-root (pi):
#  - CAP_NET_BIND_SERVICE: el web viewer bindea al puerto 80 (--web-viewer-port).
#  - CAP_NET_ADMIN: WiFi probing — el pipeline pone wlan0 en monitor mode via
#    `ip link set wlan0 down/up` + `iw dev wlan0 set type monitor`. Sin esto
#    falla con "Operation not permitted" y el probing queda desactivado (no-fatal).
#  - CAP_NET_RAW: scapy sniffea los probe requests 802.11 con raw sockets.
# Pasar --web-viewer-port 0 deshabilita el viewer (no usa NET_BIND_SERVICE).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
